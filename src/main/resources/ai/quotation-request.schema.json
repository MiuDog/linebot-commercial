{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linebot-commercial.local/schema/quotation-request-2.0.json",
  "title": "Quotation AI extraction patch",
  "description": "AI/OCR extraction-only contract. The application validates, merges, previews, calculates and executes nextAction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemeCode",
    "schemeConfidence",
    "headerPatch",
    "standardItemIntents",
    "customItems",
    "removedItemCodes",
    "imageAssessments",
    "selectedImageMessageId",
    "imageDeclined",
    "missingBaseFields",
    "missingItemFields",
    "nextAction",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "schemeCode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "CNS",
            "GENERAL",
            "MARINE",
            "BLANK",
            "SALES"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "schemeConfidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "headerPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "companyName": {
          "$ref": "#/$defs/explicitString"
        },
        "workName": {
          "$ref": "#/$defs/explicitString"
        },
        "contactName": {
          "$ref": "#/$defs/explicitString"
        },
        "phone": {
          "$ref": "#/$defs/explicitString"
        },
        "fax": {
          "$ref": "#/$defs/explicitString"
        },
        "email": {
          "$ref": "#/$defs/explicitString"
        },
        "projectLocation": {
          "$ref": "#/$defs/explicitString"
        },
        "salesRepresentative": {
          "$ref": "#/$defs/explicitString"
        },
        "additionalHeader": {
          "$ref": "#/$defs/explicitString"
        }
      }
    },
    "standardItemIntents": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "itemCode",
          "quantity",
          "sourceText",
          "confidence"
        ],
        "properties": {
          "itemCode": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,99}$"
          },
          "matchedName": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 100
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000000000
              },
              {
                "type": "null"
              }
            ]
          },
          "sourceText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "confidence": {
            "type": "number",
            "minimum": 0.75,
            "maximum": 1
          }
        }
      }
    },
    "customItems": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clientItemId",
          "kind",
          "itemName",
          "specification",
          "unit",
          "unitPrice",
          "quantity",
          "remark"
        ],
        "properties": {
          "clientItemId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "TEMPORARY",
              "DYNAMIC"
            ]
          },
          "itemName": {
            "$ref": "#/$defs/nullableExplicitString"
          },
          "specification": {
            "$ref": "#/$defs/nullableExplicitString"
          },
          "unit": {
            "$ref": "#/$defs/nullableExplicitString"
          },
          "unitPrice": {
            "$ref": "#/$defs/nullableExplicitDecimal"
          },
          "quantity": {
            "$ref": "#/$defs/nullablePositiveExplicitDecimal"
          },
          "remark": {
            "$ref": "#/$defs/nullableExplicitString"
          }
        }
      }
    },
    "removedItemCodes": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{0,99}$"
      }
    },
    "imageAssessments": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "messageId",
          "qualityScore",
          "viewpointScore",
          "distinctivenessScore",
          "reason"
        ],
        "properties": {
          "messageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "qualityScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "viewpointScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "distinctivenessScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "selectedImageMessageId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Null means no image is selected yet. A non-null value must reference an assessment with the highest distinctiveness score; ties are allowed and the application enforces this cross-field rule.",
      "maxLength": 200
    },
    "imageDeclined": {
      "type": "boolean"
    },
    "missingBaseFields": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/missingBaseField"
      }
    },
    "missingItemFields": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/missingItemFieldGroup"
      }
    },
    "nextAction": {
      "type": "string",
      "description": "Declarative recommendation only. The application validates and executes the action.",
      "enum": [
        "REQUEST_BASE_FIELDS",
        "REQUEST_ITEM_FIELDS",
        "REQUEST_IMAGE_DECISION",
        "SHOW_PREVIEW"
      ]
    },
    "warnings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  },
  "$defs": {
    "explicitString": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "sourceText",
        "confidence"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "sourceText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "confidence": {
          "type": "number",
          "minimum": 0.75,
          "maximum": 1
        }
      }
    },
    "explicitDecimal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "sourceText",
        "confidence"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "sourceText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "confidence": {
          "type": "number",
          "minimum": 0.75,
          "maximum": 1
        }
      }
    },
    "nullableExplicitString": {
      "oneOf": [
        {
          "$ref": "#/$defs/explicitString"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableExplicitDecimal": {
      "oneOf": [
        {
          "$ref": "#/$defs/explicitDecimal"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullablePositiveExplicitDecimal": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/explicitDecimal"
            },
            {
              "properties": {
                "value": {
                  "exclusiveMinimum": 0
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "missingBaseField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "reason",
        "sourceText",
        "confidence"
      ],
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "schemeCode",
            "companyName",
            "workName",
            "contactName",
            "phone",
            "fax",
            "email",
            "projectLocation",
            "salesRepresentative",
            "additionalHeader"
          ]
        },
        "reason": {
          "$ref": "#/$defs/missingReason"
        },
        "sourceText": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "missingItemFieldGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemRef",
        "fields",
        "reason",
        "sourceText",
        "confidence"
      ],
      "properties": {
        "itemRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "itemCode",
              "itemName",
              "specification",
              "unit",
              "unitPrice",
              "quantity",
              "remark"
            ]
          }
        },
        "reason": {
          "$ref": "#/$defs/missingReason"
        },
        "sourceText": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "missingReason": {
      "type": "string",
      "enum": [
        "MISSING",
        "LOW_CONFIDENCE",
        "CONFLICT"
      ]
    }
  }
}
