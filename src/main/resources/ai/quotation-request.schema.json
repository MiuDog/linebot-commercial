{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assets-manager-linebot.local/schema/quotation-request-1.0.json",
  "title": "Parsed quotation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "quotationName",
    "schemeCode",
    "schemeConfidence",
    "items",
    "selectedImageMessageId",
    "imageAssessments",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "quotationName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "schemeCode": {
      "type": "string",
      "enum": [
        "CNS",
        "GENERAL",
        "MARINE"
      ]
    },
    "schemeConfidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "itemCode",
          "quantity",
          "sourceText",
          "confidence"
        ],
        "properties": {
          "itemCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "sourceText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "selectedImageMessageId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "imageAssessments": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "messageId",
          "distinctivenessScore",
          "reason"
        ],
        "properties": {
          "messageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "distinctivenessScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  }
}
