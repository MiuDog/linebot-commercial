<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<!-- 日誌與其他持久資料共用 SYSTEM_ROOT_PATH，並固定建立在 log 子路徑。 -->
	<property name="LOG_DIR" value="${SYSTEM_ROOT_PATH:-${user.dir}/system-data}/log"/>
	<property name="LOG_LEVEL" value="${LOG_LEVEL_ROOT:-INFO}"/>
	<property name="MAX_FILE_SIZE" value="${LOG_MAX_FILE_SIZE:-20MB}"/>
	<property name="MAX_HISTORY" value="${LOG_MAX_HISTORY:-30}"/>
	<property name="TOTAL_SIZE_CAP" value="${LOG_TOTAL_SIZE_CAP:-2GB}"/>

	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<encoder class="ch.qos.logback.classic.encoder.JsonEncoder">
			<withMDC>true</withMDC>
			<withKVPList>true</withKVPList>
			<withArguments>false</withArguments>
			<withThrowable>false</withThrowable>
			<withFormattedMessage>true</withFormattedMessage>
		</encoder>
	</appender>

	<appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_DIR}/application.json</file>
		<append>true</append>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOG_DIR}/archive/application.%d{yyyy-MM-dd}.%i.json.gz</fileNamePattern>
			<maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
			<maxHistory>${MAX_HISTORY}</maxHistory>
			<totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
			<cleanHistoryOnStart>true</cleanHistoryOnStart>
		</rollingPolicy>
		<encoder class="ch.qos.logback.classic.encoder.JsonEncoder">
			<withMDC>true</withMDC>
			<withKVPList>true</withKVPList>
			<withArguments>false</withArguments>
			<withThrowable>false</withThrowable>
			<withFormattedMessage>true</withFormattedMessage>
		</encoder>
	</appender>

	<root level="${LOG_LEVEL}">
		<appender-ref ref="CONSOLE"/>
		<appender-ref ref="FILE"/>
	</root>
</configuration>
