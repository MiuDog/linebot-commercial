# 非機密部署設定；複製為 .env 後再調整。
COMPOSE_PROJECT_NAME=linebot-commercial
APP_IMAGE=linebot-commercial:local
APP_PORT=8088
COMPANY_ID=company-local
PUBLIC_BASE_URL=https://commercial.example.com
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=linebot-commercial
AI_API_URL=
AI_MODEL=
AI_MAX_COMPLETION_TOKENS=4000
QUOTATION_TAX_RATE=0.05
QUOTATION_VALIDITY_DAYS=15
SECRETS_DIR=./secrets
TUNNEL_ENABLED=false
CLOUDFLARED_PROTOCOL=http2
