# 非機密部署設定；複製為 .env 後再調整。
COMPOSE_PROJECT_NAME=linebot-commercial
APP_IMAGE=linebot-commercial:local
APP_PORT=8088
COMPANY_ID=company-local
PUBLIC_BASE_URL=https://commercial.example.com
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=linebot-commercial
AI_API_URL=
AI_MODEL=
AI_MAX_COMPLETION_TOKENS=4000

# 多模型 workflow，預設關閉以相容既有部署。
AI_WORKFLOW_ENABLED=false
AI_WORKFLOW_MAX_CALLS=3
AI_WORKFLOW_MAX_OUTPUT_TOKENS=12000
AI_WORKFLOW_MAX_TOTAL_TOKENS=32000
AI_WORKFLOW_TIMEOUT_SECONDS=120
AI_TEXT_MODEL=
AI_TEXT_API_URL=
AI_TEXT_MAX_COMPLETION_TOKENS=4000
AI_TEXT_TIMEOUT_SECONDS=60
AI_VISION_MODEL=
AI_VISION_API_URL=
AI_VISION_MAX_COMPLETION_TOKENS=4000
AI_VISION_TIMEOUT_SECONDS=60
AI_ESCALATION_MODEL=
AI_ESCALATION_API_URL=
AI_ESCALATION_MAX_COMPLETION_TOKENS=4000
AI_ESCALATION_TIMEOUT_SECONDS=60
QUOTATION_TAX_RATE=0.05
QUOTATION_VALIDITY_DAYS=15
SECRETS_DIR=./secrets
TUNNEL_ENABLED=false
CLOUDFLARED_PROTOCOL=http2
