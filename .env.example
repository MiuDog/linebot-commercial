# ============================================================
# 環境變數範本
#
# 使用方式：複製成 .env 後填入實際值。
#   cp .env.example .env
#
# .env 已被 .gitignore 排除，絕對不要提交進版控。
# 本檔案（.env.example）只放說明與空白值，可以安全提交。
# ============================================================


# ------------------------------------------------------------
# LINE Messaging API
# 取得位置：LINE Developers Console → 你的 Channel
# ------------------------------------------------------------

# Messaging API 分頁 → Channel access token（長期）
LINE_BOT_CHANNEL_TOKEN=

# Basic settings 分頁 → Channel secret
LINE_BOT_CHANNEL_SECRET=


# ------------------------------------------------------------
# 對外網址
# LINE 伺服器要靠這個網址回頭抓圖，必須是公開可存取的 HTTPS。
# 結尾不要帶斜線。
#
#   測試階段：填 ngrok 給的網址，例如 https://xxxx.ngrok-free.app
#             ngrok 免費版每次重啟都會換網址，記得同步更新這裡與 LINE Webhook 設定
#   部署階段：填公司伺服器的正式網域，例如 https://assets.example.com
# ------------------------------------------------------------
PUBLIC_BASE_URL=


# ------------------------------------------------------------
# 資產庫根目錄
#
# 圖片本體與 assets.db 都放在這個目錄底下，可以是任意路徑，
# 不需要放在專案資料夾內。目錄不存在時會在啟動時自動建立。
#
#   Windows 伺服器範例： ASSETS_ROOT=F:/資產庫
#   Linux 伺服器範例：   ASSETS_ROOT=/data/assets
#   留空則使用預設：     ./assets-store
#
# 用 docker compose 啟動時，這裡填的是「主機路徑」，
# compose 會把它掛到容器內的 /data/assets，程式不需要知道差異。
#
# 目錄結構（自動建立）：
#   {ASSETS_ROOT}/assets.db
#   {ASSETS_ROOT}/20260727/20260727-224530123.jpg
#   {ASSETS_ROOT}/20260727/20260727-224612456.jpg
#
# 磁碟上只依日期分層。資產編號（zd12345）是資料庫裡的標籤，
# 不是資料夾，因此打標籤不會搬動任何檔案。
# ------------------------------------------------------------
ASSETS_ROOT=


# ------------------------------------------------------------
# AI 資料提取
# 用於從規格圖／資訊圖擷取欄位。三項全填才會啟用，
# 缺任何一項時 #報價 指令會直接回報「尚未設定」。
# ------------------------------------------------------------

# OpenAI 相容的 chat completions 端點
# 例如 https://api.openai.com/v1/chat/completions
AI_API_URL=

# 金鑰
AI_API_KEY=

# 模型名稱（需支援讀圖）
AI_MODEL=

# 必要欄位，以逗號分隔。任何一項辨識不出來就會回報錯誤。
# 留空代表不做欄位檢查，模型回什麼就收什麼。
# 例如：品名,規格,數量,材質
AI_REQUIRED_FIELDS=

# 單次呼叫逾時秒數，留空為 60
AI_TIMEOUT_SECONDS=


# ------------------------------------------------------------
# 報價單產出
# 公式與模板尚未提供，這兩項目前保留不使用。
# ------------------------------------------------------------

# PDF 報價單模板檔路徑
QUOTATION_TEMPLATE_PATH=

# 產出的報價單存放目錄，留空時預設放在 storage 底下的 quotations
QUOTATION_OUTPUT_PATH=


# ------------------------------------------------------------
# Ngrok（僅測試階段需要）
# 取得位置：https://dashboard.ngrok.com/get-started/your-authtoken
# 部署到公司伺服器後就不需要這一項，可把 compose 的 ngrok 服務關掉。
# ------------------------------------------------------------
NGROK_AUTHTOKEN=
