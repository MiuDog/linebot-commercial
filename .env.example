# ============================================================
# 環境變數範本
#
# 使用方式：複製成 .env 後填入實際值。
#   cp .env.example .env
#
# .env 已被 .gitignore 排除，絕對不要提交進版控。
# 本檔案（.env.example）只放說明與空白值，可以安全提交。
# ============================================================


# ------------------------------------------------------------
# LINE Messaging API
# 取得位置：LINE Developers Console → 你的 Channel
# ------------------------------------------------------------

# Messaging API 分頁 → Channel access token（長期）
LINE_BOT_CHANNEL_TOKEN=

# Basic settings 分頁 → Channel secret
LINE_BOT_CHANNEL_SECRET=


# ------------------------------------------------------------
# 對外網址
# LINE 伺服器要靠這個網址回頭抓圖，必須是公開可存取的 HTTPS。
# 結尾不要帶斜線。
#
#   測試階段：填 ngrok 給的網址，例如 https://xxxx.ngrok-free.app
#             ngrok 免費版每次重啟都會換網址，記得同步更新這裡與 LINE Webhook 設定
#   部署階段：填公司伺服器的正式網域，例如 https://assets.example.com
# ------------------------------------------------------------
PUBLIC_BASE_URL=


# ------------------------------------------------------------
# 系統共同根目錄
#
# 這是唯一需要設定的本機檔案路徑。系統會自動建立：
#   {SYSTEM_ROOT_PATH}/圖片資產  圖片、待處理檔與 assets.db
#   {SYSTEM_ROOT_PATH}/報價單    Excel、PDF 與報價圖片
#   {SYSTEM_ROOT_PATH}/log       執行記錄
#
# Docker Compose 會將這個主機路徑整體掛載到容器內，不必再分別設定子路徑。
# ------------------------------------------------------------
SYSTEM_ROOT_PATH=./system-data

# 後台同步腳本專用權杖，請填入一段無法猜測的長字串。
ASSETS_SYNC_TOKEN=

# 同步已改由 scripts/sync-assets.ps1 執行；通常保持 false。
ASSETS_SYNC_ENABLED=false


# ------------------------------------------------------------
# AI 資料提取
# 用於從規格圖／資訊圖擷取欄位。三項全填才會啟用，
# 缺任何一項時 #報價 指令會直接回報「尚未設定」。
# ------------------------------------------------------------

# OpenAI 相容 API 的共同基底網址；程式會自動附加所需端點。
AI_API_URL=https://api.openai.com/v1

# 金鑰
AI_API_KEY=

# 模型名稱（需支援讀圖）
AI_MODEL=

# 必要欄位，以逗號分隔。任何一項辨識不出來就會回報錯誤。
# 留空代表不做欄位檢查，模型回什麼就收什麼。
# 例如：品名,規格,數量,材質
AI_REQUIRED_FIELDS=

# 單次呼叫逾時秒數，留空為 60
AI_TIMEOUT_SECONDS=60


# ------------------------------------------------------------
# 群組語音任務
#
# 啟用後，群組語音必須以「小定」開頭。目前支援「圖片取出」，
# 例如：小定，圖片取出 ZD12345 八月十日的圖片。
# OpenAI 會透過 PUBLIC_BASE_URL/mcp 呼叫本服務；測試時 PUBLIC_BASE_URL
# 必須是目前有效的 ngrok HTTPS 網址。
# ------------------------------------------------------------

VOICE_COMMANDS_ENABLED=false

# 語音轉錄固定使用 gpt-transcribe；任務分析共用上方 AI_MODEL、
# AI_API_URL、AI_API_KEY 與 AI_TIMEOUT_SECONDS。

# 請自行產生一段不可猜測的長字串，OpenAI 呼叫 /mcp 時會使用它驗證。
VOICE_MCP_AUTH_TOKEN=

# 留空會自動使用 PUBLIC_BASE_URL/mcp；只有 MCP 位於不同網域時才填。
VOICE_MCP_SERVER_URL=

# AI 成本採本地公式估算；三種費率都要填寫才會產生金額。
# 請填目前 AI_MODEL 官方標價中的「每百萬 token」費率。
AI_PRICE_CURRENCY=USD
AI_INPUT_RATE_PER_MILLION=
AI_CACHED_INPUT_RATE_PER_MILLION=
AI_OUTPUT_RATE_PER_MILLION=

# 報價確認／修改／取消按鈕的 HMAC 簽章密鑰。
# 請填至少 32 bytes 的隨機字串；正式環境不可沿用範例或提交到 Git。
QUOTATION_POSTBACK_SECRET=

# 候選圖片原圖／縮圖短效 HTTPS 連結簽章；建議與按鈕密鑰分離。
# 留空時會安全沿用 QUOTATION_POSTBACK_SECRET。
QUOTATION_IMAGE_LINK_SECRET=


# ------------------------------------------------------------
# 報價單產出
# ------------------------------------------------------------

# Excel 模板已內嵌於程式的 classpath:quotation/templates，報價輸出固定使用
# {SYSTEM_ROOT_PATH}/報價單，不需再填模板或輸出路徑。
# 正式核准預設值為 7 天（168 小時）；管理頁與 LINE 交付共用此期限。
QUOTATION_DELIVERY_LINK_TTL_HOURS=168
QUOTATION_PDF_TIMEOUT_SECONDS=90
# Excel COM 採單工作者；此值是允許等待的背景報價數量，滿載時保留流水號並標記可重試失敗。
QUOTATION_GENERATION_QUEUE_CAPACITY=20
QUOTATION_GENERATION_LEASE_SECONDS=120
QUOTATION_GENERATION_BATCH_SIZE=20
QUOTATION_GENERATION_POLL_INTERVAL_MS=5000
QUOTATION_GENERATION_POLL_INITIAL_DELAY_MS=5000
QUOTATION_GENERATION_WORKER_ENABLED=true


# ------------------------------------------------------------
# 流程追蹤
# 預設啟用；會記錄方法進入、完成時間與例外類型，不記錄參數內容。
# 正式環境若只需要業務事件，可設為 false。
# ------------------------------------------------------------
METHOD_TRACING_ENABLED=true

# 日誌固定寫入 {SYSTEM_ROOT_PATH}/log。
LOG_LEVEL_ROOT=INFO
LOG_MAX_FILE_SIZE=20MB
LOG_MAX_HISTORY=30
LOG_TOTAL_SIZE_CAP=2GB
RESOURCE_LOG_INTERVAL_MS=60000


# ------------------------------------------------------------
# Ngrok（僅測試階段需要）
# 取得位置：https://dashboard.ngrok.com/get-started/your-authtoken
# 部署到公司伺服器後就不需要這一項，可把 compose 的 ngrok 服務關掉。
# ------------------------------------------------------------
NGROK_AUTHTOKEN=
